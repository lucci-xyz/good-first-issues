# Environment Variables for Local Development

# OPTIONAL: Force the app to use local JSON files instead of Vercel KV
# This is useful for local development without needing KV credentials
# Set to 'true' to use public/issues.json and public/last-update.json
# If unset or false, the app will try to use Vercel KV (if configured)
USE_LOCAL_DATA=true

# OPTIONAL: GitHub Personal Access Token
# Increases rate limits when fetching issues from GitHub API
# Without this, you're limited to 60 requests per hour
# With a token, you get 5,000 requests per hour
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=your_github_token_here

# ============================================================
# Production-only variables (NOT needed for local development)
# ============================================================

# CRON_SECRET: Secret key to secure the cron job API endpoint
# Only needed in production for /api/cron/update-issues
# CRON_SECRET=your_secret_here

# Vercel KV Environment Variables
# Automatically added by Vercel when you connect a KV store
# NOT needed for local development (the app will use local JSON files)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
